# ==========================================
# MYNA LINGO API - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in the real values.

# 1. Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mynalingo?schema=public"

# 2. JWT Auth
JWT_SECRET="generate_a_long_random_string_here"

# 3. URLs
PORT=4000
BACKEND_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# 4. Agora (Video/Audio)
AGORA_APP_ID="your_agora_app_id"
AGORA_APP_CERTIFICATE="your_agora_app_certificate"

# 5. Chargily (Payments)
# Use test keys for development, live keys for production
PAYMENT_MOCK=true
CHARGILY_API_KEY="test_sk_..."
CHARGILY_API_URL="https://pay.chargily.net/test/api/v2"
CHARGILY_WEBHOOK_SECRET="test_sk_..."

# 6. Sentry (Error Tracking)
# Leave empty to disable
SENTRY_DSN=""
NODE_ENV="development"

# 7. Email / SMTP (password reset)
# Leave all four SMTP_* vars empty in development — MailService will
# log password-reset links to the console instead of sending email.
# In production, set all of SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS
# and MAIL_FROM so real reset emails are delivered.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Myna Lingo <no-reply@mynalingo.com>"