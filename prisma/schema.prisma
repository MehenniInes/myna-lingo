generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ========== ENUMS ==========
enum PresenceStatus {
  IN_CALL
  DISCONNECTED_PENDING
  LEFT
}

enum GroupSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Role {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}
enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ServiceType {
  CONVERSATION_PARTNER
  PROFESSIONAL_TEACHER
}

enum AgeCategory {
  AGE_6_11
  AGE_12_14
}

enum LedgerTransactionType {
  PACKAGE_PURCHASE
  FREE_TRIAL
  CALL_USAGE
  ADMIN_ADJUSTMENT
  REFUND
}

enum ApplicationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProficiencyLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE
}

enum XPSource {
  PODCAST_COMPLETION
  ACTIVITY_COMPLETION
  LESSON_COMPLETION
  ADMIN_ADJUSTMENT
  DAILY_STREAK
}

enum ActivityType {
  ICEBREAKER
  VISUAL_EXPRESSION
  DEBATE
  SHADOWING
  PERSONAL_TOPIC
  SHORT_STORY
  VOCABULARY_CHALLENGE
}

enum NotificationType {
  PAYMENT_SUCCESS
  MINUTES_ADDED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  CHILD_BOOKING
  CHILD_LESSON_COMPLETED
  CHILD_PROGRESS
  ANNOUNCEMENT
  PODCAST_PURCHASED
  XP_EARNED
  ADMIN_MESSAGE
}

// ========== USERS ==========
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  fullName     String
  phone        String?
  locale       String   @default("ar")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  parentProfile  ParentProfile?

  podcastPurchases PodcastPurchase[]
  podcastProgress  PodcastProgress[]
  xpTransactions   XPTransaction[]
  notifications    Notification[]
  roomPresence RoomPresence[]

  @@index([role])
}

model ParentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  children StudentProfile[]
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId String?
  parent   ParentProfile? @relation(fields: [parentId], references: [id])

  dateOfBirth DateTime?

  ledgerEntries       MinuteLedgerEntry[]
  packagePurchases    PackagePurchase[]
  groupParticipations GroupParticipant[]
  calls Call[]
  bookings Booking[]
}

// ========== TEACHER ==========
model TeacherProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName       String?
  lastName        String?
  countryOfBirth  String?
  phoneNumber     String?
  confirmedOver18 Boolean @default(false)
  profileTitle    String?
  bio             String?
  experienceYears Int?
  introVideoUrl   String?
  profilePhotoUrl String?
  isOnline        Boolean @default(false)

  idDocumentUrl     String?
  availability          Json?
  requestedHourlyRateDA Int?
  applicationStatus ApplicationStatus @default(DRAFT)
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNote        String?

  teacherLanguages TeacherLanguage[]
  spokenLanguages  SpokenLanguage[]
  educations       Education[]
  groupClasses     GroupClass[]
  calls              Call[]
  teachingTimeLedger TeachingTimeLedger[]
  bookings Booking[]
}

model SpokenLanguage {
  id         String         @id @default(cuid())
  teacherId  String
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  languageId String
  language   Language       @relation(fields: [languageId], references: [id])
  level
   String
}
model Education {
  id             String         @id @default(cuid())
  teacherId      String
  teacher        TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  university     String
  degree         String
  degreeType     String?
  specialization String?
  yearFrom       Int
  yearTo         Int
  diplomaUrl     String?
  description    String?
}

model Certificate {
  id                String          @id @default(cuid())
  teacherLanguageId String
  teacherLanguage   TeacherLanguage @relation(fields: [teacherLanguageId], references: [id], onDelete: Cascade)
  description       String?
  issuedBy          String?
  yearFrom          Int?
  yearTo            Int?
  fileUrl           String
  uploadedAt        DateTime        @default(now())
}

// ========== LANGUAGE ==========
model Language {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  teacherLanguages TeacherLanguage[]
  spokenLanguages  SpokenLanguage[]
  podcasts         Podcast[]
  groupClasses     GroupClass[]
}

model TeacherLanguage {
  id          String         @id @default(cuid())
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  languageId  String
  language    Language       @relation(fields: [languageId], references: [id])
  serviceType ServiceType

  certificates Certificate[]

  @@unique([teacherId, languageId, serviceType])
}

// ========== PRICING & PACKAGES ==========
model PricingRule {
  id               String   @id @default(cuid())
  key              String   @unique
  label            String
  pricePerMinuteDA Int
  isActive         Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  updatedBy        String
}

model Package {
  id        String   @id @default(cuid())
  priceDA   Int
  minutes   Int
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  purchases PackagePurchase[]
}

model PackagePurchase {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  packageId String
  package   Package        @relation(fields: [packageId], references: [id])
  createdAt DateTime       @default(now())
}

model MinuteLedgerEntry {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])

  type         LedgerTransactionType
  seconds      Int
  balanceAfter Int

  referenceId String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([studentId, createdAt])
}

// ========== PODCASTS ==========
model Podcast {
  id          String   @id @default(cuid())
  title       String
  description String
  coverUrl    String
  audioUrl    String
  languageId  String
  language    Language @relation(fields: [languageId], references: [id])
  level       String
  category    String
  durationSec Int
  priceDA     Int
  xpReward    Int      @default(50)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases   PodcastPurchase[]
  transcripts PodcastTranscript[]
  vocabulary  PodcastVocabulary[]
  questions   PodcastQuestion[]
  progress    PodcastProgress[]
}

model PodcastPurchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  podcastId String
  podcast   Podcast  @relation(fields: [podcastId], references: [id])
  priceDA   Int
  createdAt DateTime @default(now())

  @@unique([userId, podcastId])
}

model PodcastProgress {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  podcastId       String
  podcast         Podcast   @relation(fields: [podcastId], references: [id])
  lastPositionSec Int       @default(0)
  completed       Boolean   @default(false)
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([userId, podcastId])
}

model PodcastTranscript {
  id        String  @id @default(cuid())
  podcastId String
  podcast   Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  startSec  Int
  endSec    Int
  text      String
  order     Int
}

model PodcastVocabulary {
  id            String  @id @default(cuid())
  podcastId     String
  podcast       Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  word          String
  meaning       String
  translation   String
  example       String
  pronunciation String?
}

model PodcastQuestion {
  id         String  @id @default(cuid())
  podcastId  String
  podcast    Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  question   String
  options    String[]
  correctIdx Int
  order      Int
}

// ========== XP & LEVELS ==========
model XPTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  source      XPSource
  referenceId String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model Level {
  id       String  @id @default(cuid())
  number   Int     @unique
  name     String
  minXP    Int
  maxXP    Int
  badgeUrl String?
}

// ========== ACTIVITIES ==========
model LearningActivity {
  id          String       @id @default(cuid())
  type        ActivityType
  title       String
  description String?
  content     Json
  xpReward    Int          @default(20)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  questions ActivityQuestion[]
}

model ActivityQuestion {
  id         String           @id @default(cuid())
  activityId String
  activity   LearningActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  question   String
  options    String[]
  answer     String?
  order      Int
}

// ========== GROUP CLASSES ==========
model GroupClass {
  id          String         @id @default(cuid())
  title       String
  description String?
  languageId  String
  language    Language       @relation(fields: [languageId], references: [id])
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
  ageCategory AgeCategory
  capacity    Int            @default(6)
  priceDA     Int
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  participants GroupParticipant[]
  sessions GroupSession[]
}

model GroupParticipant {
  id           String         @id @default(cuid())
  groupClassId String
  groupClass   GroupClass     @relation(fields: [groupClassId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id])
  joinedAt     DateTime       @default(now())

  @@unique([groupClassId, studentId])
}

// ========== NOTIFICATIONS ==========
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

enum CallStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TeachingTimeType {
  LESSON_COMPLETED
  PAYMENT_REQUESTED
  TIME_FROZEN
  PAYMENT_COMPLETED
  ADMIN_ADJUSTMENT
}
// ========== CALLS & TEACHING TIME ==========
model Call {
  id             String        @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  teacherId      String
  teacher        TeacherProfile @relation(fields: [teacherId], references: [id])
  serviceType    ServiceType
  agoraChannelId String?
  startTime      DateTime      @default(now())
  endTime        DateTime?
  durationSec    Int           @default(0)
  status         CallStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now())

  @@index([studentId, status])
  @@index([teacherId, status])
}

model TeachingTimeLedger {
  id           String            @id @default(cuid())
  teacherId    String
  teacher      TeacherProfile    @relation(fields: [teacherId], references: [id])
  type         TeachingTimeType
  seconds      Int
  balanceAfter Int
  referenceId  String?
  note         String?
  createdAt    DateTime          @default(now())

  @@index([teacherId, createdAt])
}
model Booking {
  id          String        @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
  serviceType ServiceType
  scheduledAt DateTime
  durationMin Int           @default(30)
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())

  @@index([studentId, status])
  @@index([teacherId, status])
}

// ========== GROUP SESSIONS (Persistent Rooms) ==========
model GroupSession {
  id           String             @id @default(cuid())
  groupClassId String
  groupClass   GroupClass         @relation(fields: [groupClassId], references: [id])
  roomId       String             @unique
  agoraChannel String?
  status       GroupSessionStatus @default(ACTIVE)
  startedAt    DateTime           @default(now())
  endedAt      DateTime?
  createdBy    String
  createdAt    DateTime           @default(now())

  participants RoomPresence[]

  @@index([groupClassId, status])
}

model RoomPresence {
  id         String         @id @default(cuid())
  sessionId  String
  session    GroupSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     PresenceStatus @default(IN_CALL)
  joinedAt   DateTime       @default(now())
  lastSeenAt DateTime       @default(now())
  leftAt     DateTime?

  @@unique([sessionId, userId])
  @@index([userId, status])
  @@index([sessionId, status])
}